# Copy this file to config/.env and fill the values.

APP_ENV=local
DATABASE_URL=postgresql://treeway:treeway@localhost:5432/treeway
DB_POOL_MIN=2
DB_POOL_MAX=10

# Treeway uses its own Redis (port 6380 on the server, so it never mixes with other apps)
REDIS_URL=redis://localhost:6379/5

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
TOKEN_EXPIRATION_MINUTES=720

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8100
CORS_ORIGINS=http://localhost:5173

# First admin (created by seed.py only if no admin exists)
ADMIN_MOBILE=9000000000
ADMIN_EMAIL=admin@treeway.in
ADMIN_PASSWORD=change-me-admin

# Email OTP (leave SMTP_HOST empty locally: OTP is printed in the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SMTP_PASS also works. A Gmail App Password may keep its spaces.
SMTP_PASSWORD=
MAIL_FROM_NAME=Treeway
# Sender address if it is not SMTP_USER (optional)
MAIL_FROM=
# local / e2e / demo only: real mail goes ONLY to these addresses (comma separated); every other address is
# printed in the console. Production ignores it and mails everyone.
MAIL_ALLOWLIST=

# On the server (behind nginx) set TRUST_PROXY=1
TRUST_PROXY=0
