# /home/treeway/app/config/.env on the server.  chmod 600, owner treeway.  Never commit the real one.

APP_ENV=production
# 64 random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME
ALGORITHM=HS256
TOKEN_EXPIRATION_MINUTES=720

# Postgres directly (127.0.0.1:5432). With PgBouncer later: port 6432 for the API and DB_STATEMENT_CACHE_SIZE=0;
# the scheduler stays on 5432 (it uses session advisory locks).
DATABASE_URL=postgresql://treeway:CHANGE-ME@127.0.0.1:5432/treeway
DB_POOL_MIN=2
DB_POOL_MAX=10

# Treeway's own Redis (deploy/redis), never the shared one.
REDIS_URL=redis://:CHANGE-ME@127.0.0.1:6380/0

# The app and the API (deploy/nginx/treeway-web.conf + treeway-api.conf). FRONTEND_URL makes the join and
# password-reset links. The app calls /api on its own domain (nginx passes it on), so CORS is only a safety list.
FRONTEND_URL=https://treeway.avigronix.com
BACKEND_URL=https://apitreeway.avigronix.com
CORS_ORIGINS=https://treeway.avigronix.com

# nginx sets X-Real-IP from Cloudflare's CF-Connecting-IP; only then trust it.
TRUST_PROXY=1

# First admin (used once by seed.py; it refuses a weak password in production: 12+ characters, small + capital
# letters, a number and a symbol). Remove ADMIN_PASSWORD from this file after the first login.
ADMIN_MOBILE=CHANGE-ME
ADMIN_EMAIL=CHANGE-ME
ADMIN_PASSWORD=CHANGE-ME

# Email: OTPs and alerts. Without SMTP in production every OTP request fails (by design).
SMTP_HOST=CHANGE-ME
SMTP_PORT=587
SMTP_USER=CHANGE-ME
SMTP_PASSWORD=CHANGE-ME
# ZeptoMail / Amazon SES: see treeway/docs/STAGING_CHECKLIST.md §3. MAIL_FROM must be on the verified domain.
MAIL_FROM=no-reply@avigronix.com
MAIL_FROM_NAME=Treeway

# Night-job failures, health and backup alerts (comma separated).
ALERT_EMAIL=CHANGE-ME
